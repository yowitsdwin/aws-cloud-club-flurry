# Server Config
PORT=3000
HOST=0.0.0.0

# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# OR use SUPABASE_SERVICE_ROLE_KEY if bypassing Row Level Security (RLS) policies for admin submissions
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth (for officer authentication)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT & Cookie Secrets (change these in production!)
JWT_SECRET=flurry-jwt-secret-key
COOKIE_SECRET=flurry-cookie-secret-key-32chars-min-needed

# Environment (set to 'production' to enable secure cookies)
# NODE_ENV=production

# Resend Email Service (for Member ID recovery)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
